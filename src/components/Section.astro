---
interface Props {
  id: string;
  title: string;
  customButtonText?: string; // Optional custom button text
}

const { id, title } = Astro.props;
---
<section id={id} class="py-10">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="text-2xl font-bold mb-8 text-primary text-center">
      {title}
    </h2>
    <slot />
  </div>
</section>