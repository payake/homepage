---
import Section from '../Section.astro';
import { aboutMe } from '../../config/personalInfo';
---
<Section id="about" title="About Me">
  <div class="prose prose-lg space-y-5">
    <p class="text-content-medium">
      {aboutMe.description}
    </p>  
     <div class="badge-grid">
        <div class="badge large">
          <div data-iframe-width="300" data-iframe-height="300" data-share-badge-id="202d6252-f93a-486f-8003-e5c775d5f6f6" data-share-badge-host="https://www.credly.com"></div>
          <script type="text/javascript" async src="//cdn.credly.com/assets/utilities/embed.js"></script>
        </div>
        <div class="badge small">
          <div data-iframe-width="300" data-iframe-height="300" data-share-badge-id="36a660fb-8628-491a-a25c-c0e85e54c9e9" data-share-badge-host="https://www.credly.com"></div>
          <script type="text/javascript" async src="//cdn.credly.com/assets/utilities/embed.js"></script>
        </div>
         <div class="badge small">
          <div data-iframe-width="300" data-iframe-height="300" data-share-badge-id="210a5fe6-cfdb-40b6-988d-77640d817286" data-share-badge-host="https://www.credly.com"></div>
          <script type="text/javascript" async src="//cdn.credly.com/assets/utilities/embed.js"></script>
        </div>
      </div>
  </div>
</Section>

<style>
  .badge-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 5px;
    justify-items: center;
    align-items: start;
  }

  .large {
    grid-column: 1 / -1;
  }
</style>